# Optional. Demo mode (the default) needs none of these.
# The server reads the process environment; export them yourself, never commit real values.

# Any OpenAI-compatible /chat/completions server (python3 -m acs.server --mode openai)
ACS_OPENAI_BASE_URL=http://127.0.0.1:8791/v1
ACS_OPENAI_MODEL=Qwen/Qwen2.5-1.5B-Instruct
ACS_OPENAI_API_KEY=
ACS_LLM_TEMPERATURE=0.2

# Anthropic Messages API (python3 -m acs.server --mode llm)
ACS_LLM_API_KEY=
ACS_LLM_MODEL=claude-sonnet-5-5

ACS_LLM_TIMEOUT=60
ACS_DEMO_DELAY=0.7
